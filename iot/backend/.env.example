# Twilio
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+19134533398

# Base URL (set to your Render/ngrok URL)
BASE_URL=https://your-app.onrender.com

# AI Services
GROQ_API_KEY=your_groq_api_key_here

# JWT
JWT_SECRET=super-secret-iot-key-123

# Database
DATABASE_URL=sqlite:///./irrigation.db

# Google Earth Engine
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee-key.json

# MQTT Configuration
# Leave MQTT_USERNAME and MQTT_PASSWORD blank for public brokers (e.g. broker.hivemq.com)
# Set them when using authenticated brokers (HiveMQ Cloud, EMQX Cloud, etc.)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=irrigation/telemetry
MQTT_TOPIC_STATUS=irrigation/status/+
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RECONNECT_DELAY_S=10
